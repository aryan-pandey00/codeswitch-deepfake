# Vite inlines this at build time, so a missing value produces a site that silently serves the
# offline example instead of talking to the API. Committing it removes that failure mode from
# the deploy: the URL is public anyway, since the browser calls it directly.
# An environment variable set in the hosting dashboard still overrides this file.
VITE_API_URL=https://aryankumarpandey05--codeswitch-deepfake-api-api.modal.run
